generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  createdAt        DateTime          @default(now())
  drafts           Draft[]
  googleConnection GoogleConnection?
}

model GoogleConnection {
  id            String   @id @default(uuid())
  userId        String   @unique
  googleUserId  String
  email         String
  accessToken   String
  refreshToken  String
  tokenExpiry   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts        Draft[]
}

model Draft {
  id                  String            @id @default(uuid())
  name                String
  userId              String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  industryRanges      Json?
  googleSheetUrl      String?
  googleSpreadsheetId String?
  googleWorksheetName String?
  googleConnectionId  String?
  assignments         BoothAssignment[]
  companies           Company[]
  user                User              @relation(fields: [userId], references: [id])
  googleConnection    GoogleConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)
}

model Company {
  id            String            @id @default(uuid())
  name          String
  days          Day[]
  sponsorship   Sponsorship       @default(BASIC)
  boothCount    Int               @default(1)
  draftId       String
  hasQueue      Boolean           @default(false)
  industry      Industry          @default(OTHER)
  isPlaceholder Boolean           @default(false)
  assignments   BoothAssignment[]
  draft         Draft             @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model BoothAssignment {
  id        String   @id @default(uuid())
  companyId String
  draftId   String
  boothIds  String[]
  day       Day?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([companyId, draftId])
}

enum Sponsorship {
  MAROON
  DIAMOND
  GOLD
  SILVER
  BASIC
}

enum Day {
  WEDNESDAY
  THURSDAY
}

enum Industry {
  AEROSPACE
  MECHANICAL
  ENERGY
  CHEMICALS
  OIL
  CIVIL
  TECH
  SEMICONDUCTORS
  OTHER
}
